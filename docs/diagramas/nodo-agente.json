  "cards": [
    {
      "dot": "cyan",
      "title": "Bucle modelo ↔ herramientas",
      "items": [
        "Lectura sin aprobación: search_documents (Qdrant + BM25), query_structured (tabla SQLite) y aggregate_series (CSV curado)",
        "ToolCallLimitMiddleware y ModelCallLimitMiddleware acotan el bucle por turno"
      ]
    },
    {
      "dot": "rose",
      "title": "Human-in-the-Loop",
      "items": [
        "Escritura: save_profile, save_preference, forget_memory y export_conversation se detienen en interrupt hasta aprobar, editar o rechazar",
        "Al reanudar, el resultado vuelve al modelo como mensaje de herramienta"
      ]
    },
    {
      "dot": "emerald",
      "title": "Salida segura",
      "items": [
        "Los documentos llegan como datos en <documento> y las órdenes embebidas se neutralizan",
        "validate_answer descarta citas inválidas y respuestas que copian el system prompt"
      ]
    }
  ]
