# Proveedor DeepSeek por API (spec 011).
# Copia este archivo a .env y completa la clave. `.env` NO se versiona.
DEEPSEEK_API_KEY=

# Opcionales: sobrescriben config/llm.toml para pruebas manuales o proxies.
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Modo demostración: respuestas de prueba sin red ni costo.
# PML_DEMO=1

# Observabilidad con LangSmith (opcional). LangSmith observa, no orquesta: traza enrutador,
# herramientas, recuperación y modelo de cada turno. Sin estas variables queda el log local
# $MANUELITA_STATE_DIR/logs/turns.jsonl.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=manuelita-modulo2

# Qdrant con servidor (opcional): usa el índice HNSW. Sin ella se usa el modo local embebido.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
