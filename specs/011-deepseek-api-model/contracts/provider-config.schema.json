{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonCastano/proyecto_modelos_lenguaje/specs/011-deepseek-api-model/contracts/provider-config.schema.json",
  "title": "LLM provider configuration",
  "description": "Forma serializada de ProviderConfig (config/llm.toml). Nunca contiene el valor de la clave.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "model",
    "base_url",
    "api_key_env",
    "api_key_present",
    "temperature",
    "top_p",
    "max_output_tokens",
    "context_window",
    "default_context_pack",
    "timeout_seconds",
    "max_retries",
    "retry_backoff_seconds",
    "cost_per_1k_input",
    "cost_per_1k_output",
    "language"
  ],
  "properties": {
    "provider": { "type": "string", "enum": ["deepseek"] },
    "model": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
    "base_url": { "type": "string", "pattern": "^https://" },
    "api_key_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "api_key_present": { "type": "boolean" },
    "temperature": { "type": "number", "minimum": 0, "maximum": 1 },
    "top_p": { "type": "number", "minimum": 0.01, "maximum": 1 },
    "max_output_tokens": { "type": "integer", "minimum": 128, "maximum": 8192 },
    "context_window": { "type": "integer", "minimum": 2048, "maximum": 131072 },
    "default_context_pack": { "type": "string", "enum": ["8000", "32000"] },
    "timeout_seconds": { "type": "integer", "minimum": 5, "maximum": 300 },
    "max_retries": { "type": "integer", "minimum": 0, "maximum": 3 },
    "retry_backoff_seconds": { "type": "number", "minimum": 0, "maximum": 30 },
    "cost_per_1k_input": { "type": "number", "minimum": 0 },
    "cost_per_1k_output": { "type": "number", "minimum": 0 },
    "language": { "type": "string", "enum": ["es", "en"] }
  }
}
