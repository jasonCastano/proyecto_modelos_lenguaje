{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonCastano/proyecto_modelos_lenguaje/contracts/gold/run-report.schema.json",
  "title": "GoldRunReport",
  "description": "Reporte de calidad de una ejecución de la capa oro.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "finished_at",
    "status",
    "config_hash",
    "input_documents",
    "input_chunks",
    "processed",
    "skipped",
    "failed",
    "units",
    "facts",
    "entities",
    "conflicts",
    "coverage",
    "context_packs",
    "tokens",
    "duration_seconds",
    "quality_flags",
    "skip_reasons",
    "failure_reasons",
    "report_paths"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-gold-\\d{2}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["completed", "completed_with_failures", "failed"] },
    "config_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input_documents": { "type": "integer", "minimum": 0 },
    "input_chunks": { "type": "integer", "minimum": 0 },
    "processed": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "units": { "type": "integer", "minimum": 0 },
    "facts": { "type": "integer", "minimum": 0 },
    "entities": { "type": "integer", "minimum": 0 },
    "conflicts": { "type": "integer", "minimum": 0 },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "partial", "missing"],
      "properties": {
        "covered": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 }
      }
    },
    "context_packs": { "type": "integer", "minimum": 0 },
    "tokens": { "type": "integer", "minimum": 0 },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "quality_flags": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "skip_reasons": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "failure_reasons": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "report_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
