  "flows": [
    {
      "id": "discovery",
      "from": "sources",
      "to": "campaign",
      "label": "descubrimiento",
      "classification": "URLs y sitemaps",
      "variant": "emphasis"
    },
    {
      "id": "raw-artifacts",
      "from": "campaign",
      "to": "bronze",
      "label": "bytes + hash",
      "classification": "artefactos crudos",
      "variant": "emphasis"
    },
    {
      "id": "canonical-text",
      "from": "bronze",
      "to": "silver",
      "label": "texto canónico",
      "classification": "limpieza y dedupe",
      "variant": "emphasis"
    },
    {
      "id": "knowledge",
      "from": "silver",
      "to": "gold",
      "label": "unidades + hechos",
      "classification": "base de conocimiento",
      "variant": "emphasis"
    },
    {
      "id": "evidence",
      "from": "gold",
      "to": "retrieval",
      "label": "contexto [U#]",
      "classification": "evidencia citada",
      "variant": "emphasis"
    },
    {
      "id": "prompt-context",
      "from": "retrieval",
      "to": "llm",
      "label": "evidencia",
      "classification": "contexto del prompt",
      "variant": "default"
    },
    {
      "id": "answer",
      "from": "llm",
      "to": "app",
      "label": "respuesta citada",
      "classification": "respuesta, fallback y traza",
      "variant": "emphasis"
    },
    {
      "id": "embedding-index",
      "from": "gold",
      "to": "rag-index",
      "label": "embeddings por lotes",
      "classification": "índice reproducible",
      "variant": "default"
    },
    {
      "id": "semantic-topk",
      "from": "rag-index",
      "to": "retrieval",
      "label": "top-k semántico",
      "classification": "fusión con léxica",
      "variant": "default"
    },
    {
      "id": "route",
      "from": "router",
      "to": "agent",
      "label": "ruta",
      "classification": "5 rutas con confianza",
      "variant": "emphasis"
    },
    {
      "id": "search-tool",
      "from": "retrieval",
      "to": "agent",
      "label": "búsqueda",
      "classification": "<documento> aislado",
      "variant": "default"
    },
    {
      "id": "facts",
      "from": "gold",
      "to": "structured",
      "label": "hechos",
      "classification": "agent build-structured",
      "variant": "default"
    },
    {
      "id": "structured-tool",
      "from": "structured",
      "to": "agent",
      "label": "datos",
      "classification": "consulta parametrizada",
      "variant": "default"
    },
    {
      "id": "thread-state",
      "from": "agent",
      "to": "memory",
      "label": "estado",
      "classification": "escritura con aprobación",
      "variant": "default"
    },
    {
      "id": "chat-answer",
      "from": "agent",
      "to": "app",
      "label": "turno citado",
      "classification": "ruta, fragmentos, acción pendiente",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Trazabilidad de extremo a extremo",
      "items": [
        "Cada artefacto conserva URL, fecha UTC, fuente y hash SHA-256.",
        "El catálogo SQLite registra procedencia, deduplicación y auditoría.",
        "Los datos se versionan en Git LFS; la cuarentena queda fuera."
      ]
    },
    {
      "dot": "orange",
      "title": "Recuperación y respuesta",
      "items": [
        "Recuperación híbrida: e5-small semántico fusionado con BM25 léxico del Módulo 1.",
        "Sin índice válido, cae a recuperación léxica y lo declara en la traza.",
        "Resumen, FAQ y Q&A con LangChain y DeepSeek, prompts versionados y citas [U#].",
        "Sin evidencia suficiente, la app declara fallback y muestra los fragmentos recuperados.",
        "Conversación con memoria: enrutador en dos etapas, variantes cadena y agente sobre el mismo hilo.",
        "Fragmentos con instrucciones embebidas se marcan; respuestas que copian el prompt se descartan."
      ]
    },
    {
      "dot": "slate",
      "title": "Límites declarados",
      "items": [
        "La app es de solo lectura sobre data/: memoria e índice viven en MANUELITA_STATE_DIR o data/module2.",
        "El índice semántico es una vista derivada del oro: se reconstruye, no se versiona.",
        "Toda escritura (preferencias, olvido, exportación) espera una decisión humana registrada."
      ]
    }
  ]
}
