{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonCastano/proyecto_modelos_lenguaje/contracts/silver/document.schema.json",
  "title": "SilverDocument",
  "description": "Registro de documento limpio de la capa plata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_id",
    "artifact_id",
    "campaign_id",
    "content_hash",
    "text_hash",
    "source_id",
    "authority",
    "url",
    "url_canonical",
    "title",
    "published_at",
    "retrieved_at",
    "language",
    "language_method",
    "category",
    "media_type",
    "cleaning_version",
    "config_hash",
    "status",
    "canonical_doc_id",
    "duplicate_of",
    "aliases",
    "quality_flags",
    "sections",
    "text",
    "char_count",
    "token_count",
    "license_note",
    "markdown_path"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "doc_id": { "type": "string", "pattern": "^doc_[a-f0-9]{16}$" },
    "artifact_id": { "type": "integer", "minimum": 1 },
    "campaign_id": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "text_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_id": { "type": "string", "minLength": 1 },
    "authority": { "enum": ["first_party", "third_party", "open_data"] },
    "url": { "type": "string", "format": "uri" },
    "url_canonical": { "type": "string", "format": "uri" },
    "title": { "type": "string", "minLength": 1 },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "language": { "enum": ["es", "en", "und"] },
    "language_method": { "enum": ["html_lang", "heuristic", "unknown"] },
    "category": { "enum": ["identity", "offer", "digital_presence", "hard_data"] },
    "media_type": { "type": "string", "minLength": 1 },
    "cleaning_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "config_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["canonical", "alias"] },
    "canonical_doc_id": {
      "type": ["string", "null"],
      "pattern": "^doc_[a-f0-9]{16}$"
    },
    "duplicate_of": {
      "type": ["string", "null"],
      "pattern": "^doc_[a-f0-9]{16}$"
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "pattern": "^doc_[a-f0-9]{16}$" },
      "uniqueItems": true
    },
    "quality_flags": {
      "type": "array",
      "items": { "$ref": "#/$defs/qualityFlag" },
      "uniqueItems": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    },
    "text": { "type": "string", "minLength": 1 },
    "char_count": { "type": "integer", "minimum": 1 },
    "token_count": { "type": "integer", "minimum": 1 },
    "license_note": { "type": "string", "minLength": 1 },
    "markdown_path": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "alias" } }, "required": ["status"] },
      "then": {
        "properties": {
          "canonical_doc_id": { "type": "string", "pattern": "^doc_[a-f0-9]{16}$" },
          "duplicate_of": { "type": "string", "pattern": "^doc_[a-f0-9]{16}$" }
        }
      },
      "else": {
        "properties": {
          "canonical_doc_id": { "type": "null" },
          "duplicate_of": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "qualityFlag": {
      "enum": [
        "no_text",
        "scanned_pdf",
        "encrypted_pdf",
        "low_text_density",
        "table_heavy",
        "multi_column_suspect",
        "encoding_repaired",
        "no_section",
        "short_section",
        "exact_duplicate",
        "near_duplicate",
        "language_unknown",
        "subtitle_kind_unknown"
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "title",
        "path",
        "level",
        "order",
        "char_start",
        "char_end",
        "page_start",
        "page_end",
        "time_start",
        "time_end"
      ],
      "properties": {
        "section_id": { "type": "string", "pattern": "^doc_[a-f0-9]{16}-s\\d{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "level": { "type": "integer", "minimum": 0, "maximum": 6 },
        "order": { "type": "integer", "minimum": 0 },
        "char_start": { "type": "integer", "minimum": 0 },
        "char_end": { "type": "integer", "minimum": 1 },
        "page_start": { "type": ["integer", "null"], "minimum": 1 },
        "page_end": { "type": ["integer", "null"], "minimum": 1 },
        "time_start": { "type": ["number", "null"], "minimum": 0 },
        "time_end": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
