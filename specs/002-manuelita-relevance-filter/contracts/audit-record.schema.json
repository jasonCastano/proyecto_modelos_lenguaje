{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelita-rag.local/contracts/audit-record.schema.json",
  "title": "CurationAuditRecord",
  "description": "Permanent provenance record for an artifact removed from the active corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "run_id",
    "artifact_id",
    "url_canonical",
    "content_hash",
    "byte_size",
    "media_type",
    "source_id",
    "decision",
    "reason",
    "score",
    "decided_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "audit_id": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "artifact_id": { "type": "integer", "minimum": 1 },
    "url_canonical": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "byte_size": { "type": "integer", "minimum": 1 },
    "media_type": { "type": "string", "minLength": 3, "maxLength": 200 },
    "source_id": { "type": "string", "pattern": "^[a-z0-9_]{2,40}$" },
    "decision": { "const": "remove" },
    "reason": { "type": "string", "minLength": 3, "maxLength": 1000 },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "location", "snippet"],
        "properties": {
          "term": { "type": "string", "maxLength": 200 },
          "location": { "enum": ["title", "body", "url", "metadata"] },
          "snippet": { "type": "string", "maxLength": 500 },
          "weight": { "type": "integer", "minimum": -100, "maximum": 100 }
        }
      }
    },
    "decided_at": { "type": "string", "format": "date-time" },
    "quarantined_at": { "type": ["string", "null"], "format": "date-time" },
    "purged_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
