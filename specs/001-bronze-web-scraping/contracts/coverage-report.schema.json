{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelita-rag.local/contracts/coverage-report.schema.json",
  "title": "CoverageReport",
  "description": "Coverage matrix for the 24 required information items of a campaign.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "generated_at", "summary", "items"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "campaign_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "partial", "missing", "total", "gaps"],
      "properties": {
        "covered": { "type": "integer", "minimum": 0, "maximum": 24 },
        "partial": { "type": "integer", "minimum": 0, "maximum": 24 },
        "missing": { "type": "integer", "minimum": 0, "maximum": 24 },
        "total": { "const": 24 },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item_id", "reason"],
            "properties": {
              "item_id": { "type": "string", "pattern": "^[IODH]-[0-9]{2}$" },
              "reason": { "type": "string", "minLength": 3, "maxLength": 500 }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "category", "name", "status", "evidence_count", "artifact_refs"],
        "properties": {
          "item_id": { "type": "string", "pattern": "^[IODH]-[0-9]{2}$" },
          "category": { "enum": ["identity", "offer", "digital_presence", "hard_data"] },
          "name": { "type": "string", "minLength": 3, "maxLength": 200 },
          "status": { "enum": ["covered", "partial", "missing"] },
          "evidence_count": { "type": "integer", "minimum": 0 },
          "artifact_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1 }
          },
          "gap_reason": { "type": ["string", "null"], "maxLength": 500 }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "missing" } } },
            "then": { "required": ["gap_reason"] }
          }
        ]
      }
    }
  }
}
