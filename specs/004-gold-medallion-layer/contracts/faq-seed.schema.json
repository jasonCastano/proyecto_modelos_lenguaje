{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonCastano/proyecto_modelos_lenguaje/contracts/gold/faq-seed.schema.json",
  "title": "GoldFAQSeed",
  "description": "Pregunta semilla para la tarea FAQ del Módulo 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seed_id",
    "question",
    "topic_id",
    "coverage_item_id",
    "evidence_unit_ids",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "seed_id": { "type": "string", "pattern": "^faq_[a-f0-9]{16}$" },
    "question": { "type": "string", "minLength": 10 },
    "topic_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "coverage_item_id": {
      "type": ["string", "null"],
      "pattern": "^[IODH]-\\d{2}$"
    },
    "evidence_unit_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^unit_[a-f0-9]{16}$" },
      "uniqueItems": true
    },
    "status": { "enum": ["ready", "review", "missing_evidence"] }
  }
}
