{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelita-rag.local/contracts/curation-report.schema.json",
  "title": "CurationReport",
  "description": "Summary of a relevance analysis and cleanup run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "generated_at",
    "config_hash",
    "thresholds",
    "counts",
    "by_source",
    "bytes",
    "samples",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "status": {
      "enum": ["planned", "analyzing", "analyzed", "approved", "quarantining", "quarantined", "purging", "purged", "aborted"]
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "config_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keep", "review"],
      "properties": {
        "keep": { "type": "integer", "minimum": 0, "maximum": 100 },
        "review": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluated", "kept", "removed", "review", "reviewed_kept", "reviewed_removed"],
      "properties": {
        "evaluated": { "type": "integer", "minimum": 0 },
        "kept": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "review": { "type": "integer", "minimum": 0 },
        "reviewed_kept": { "type": "integer", "minimum": 0 },
        "reviewed_removed": { "type": "integer", "minimum": 0 }
      }
    },
    "by_source": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "total", "kept", "removed", "review"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z0-9_]{2,40}$" },
          "total": { "type": "integer", "minimum": 0 },
          "kept": { "type": "integer", "minimum": 0 },
          "removed": { "type": "integer", "minimum": 0 },
          "review": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "quarantined", "freed"],
      "properties": {
        "before": { "type": "integer", "minimum": 0, "maximum": 10000000000 },
        "quarantined": { "type": "integer", "minimum": 0, "maximum": 10000000000 },
        "freed": { "type": "integer", "minimum": 0, "maximum": 10000000000 }
      }
    },
    "samples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kept", "removed"],
      "properties": {
        "kept": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "url_canonical", "score"],
            "properties": {
              "artifact_id": { "type": "integer", "minimum": 1 },
              "url_canonical": { "type": "string", "format": "uri" },
              "score": { "type": "integer", "minimum": 0, "maximum": 100 },
              "reason": { "type": ["string", "null"], "maxLength": 300 }
            }
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "url_canonical", "score"],
            "properties": {
              "artifact_id": { "type": "integer", "minimum": 1 },
              "url_canonical": { "type": "string", "format": "uri" },
              "score": { "type": "integer", "minimum": 0, "maximum": 100 },
              "reason": { "type": ["string", "null"], "maxLength": 300 }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "maxLength": 500 }
    }
  }
}
