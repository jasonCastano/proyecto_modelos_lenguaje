{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonCastano/proyecto_modelos_lenguaje/specs/007-langchain-qa-tasks/contracts/task-result.schema.json",
  "title": "LangChain task result",
  "description": "Result of a summary, FAQ or Q&A task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "status",
    "answer",
    "citations",
    "used_unit_ids",
    "omitted_unit_ids",
    "prompt_version",
    "prompt_sha256",
    "model",
    "latency_seconds",
    "input_tokens",
    "output_tokens",
    "fallback",
    "review_required",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task": {
      "type": "string",
      "enum": ["summary", "faq", "qa"]
    },
    "status": {
      "type": "string",
      "enum": ["ok", "fallback", "review", "error"]
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "used_unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^unit_[a-f0-9]{16}$"
      },
      "uniqueItems": true
    },
    "omitted_unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^unit_[a-f0-9]{16}$"
      },
      "uniqueItems": true
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "latency_seconds": {
      "type": "number",
      "minimum": 0
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "fallback": {
      "type": "boolean"
    },
    "review_required": {
      "type": "boolean"
    },
    "error": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "fallback"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "fallback": {"const": true},
          "citations": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "ok"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "fallback": {"const": false},
          "citations": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "error"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "error": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "unit_id",
        "title",
        "url",
        "section_path",
        "page_start",
        "page_end",
        "time_start",
        "time_end",
        "authority",
        "citation"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^U[0-9]+$"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^unit_[a-f0-9]{16}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "section_path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "page_start": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "page_end": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "time_start": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "time_end": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "authority": {
          "type": "string",
          "enum": ["first_party", "open_data", "third_party"]
        },
        "citation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
