  "cards": [
    {
      "dot": "emerald",
      "title": "Trazabilidad de extremo a extremo",
      "items": [
        "Cada artefacto conserva URL, fecha UTC, fuente y hash SHA-256.",
        "El catálogo SQLite registra procedencia, deduplicación y auditoría.",
        "Los datos se versionan en Git LFS; la cuarentena queda fuera."
      ]
    },
    {
      "dot": "orange",
      "title": "Consumo del Módulo 1",
      "items": [
        "La recuperación es léxica y determinista: no usa embeddings.",
        "Las tres tareas usan prompts versionados y citas [U#].",
        "Si no hay evidencia, la app declara fallback explícito."
      ]
    },
    {
      "dot": "slate",
      "title": "Límites declarados",
      "items": [
        "La app es de solo lectura: no escribe en data/.",
        "Ollama es local; el modo demostración no requiere red.",
        "Embeddings, base vectorial y memoria pertenecen al Módulo 2."
      ]
    }
  ]
