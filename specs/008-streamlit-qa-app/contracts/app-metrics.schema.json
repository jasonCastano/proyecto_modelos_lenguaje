{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonCastano/proyecto_modelos_lenguaje/specs/008-streamlit-qa-app/contracts/app-metrics.schema.json",
  "title": "App metrics",
  "description": "Read-only corpus metrics shown by the Streamlit app.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "active_artifacts",
    "canonical_documents",
    "aliases",
    "chunks",
    "units",
    "facts",
    "entities",
    "conflicts",
    "coverage_covered",
    "coverage_total",
    "silver_tokens",
    "gold_tokens",
    "skipped",
    "omissions",
    "silver_run",
    "gold_run",
    "data_status",
    "detail"
  ],
  "properties": {
    "active_artifacts": {
      "type": "integer",
      "minimum": 0
    },
    "canonical_documents": {
      "type": "integer",
      "minimum": 0
    },
    "aliases": {
      "type": "integer",
      "minimum": 0
    },
    "chunks": {
      "type": "integer",
      "minimum": 0
    },
    "units": {
      "type": "integer",
      "minimum": 0
    },
    "facts": {
      "type": "integer",
      "minimum": 0
    },
    "entities": {
      "type": "integer",
      "minimum": 0
    },
    "conflicts": {
      "type": "integer",
      "minimum": 0
    },
    "coverage_covered": {
      "type": "integer",
      "minimum": 0,
      "maximum": 24
    },
    "coverage_total": {
      "const": 24
    },
    "silver_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "gold_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "omissions": {
      "type": "integer",
      "minimum": 0
    },
    "silver_run": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-silver-\\d{2}$"
    },
    "gold_run": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-gold-\\d{2}$"
    },
    "data_status": {
      "type": "string",
      "enum": ["complete", "incomplete", "unknown"]
    },
    "detail": {
      "type": ["string", "null"]
    }
  }
}
