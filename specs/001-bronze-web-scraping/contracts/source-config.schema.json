{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelita-rag.local/contracts/source-config.schema.json",
  "title": "BronzeSourceConfig",
  "description": "Validation contract for config/sources.toml. TOML tables mirror these JSON objects: [settings], [[sources]], [exclusions].",
  "type": "object",
  "additionalProperties": false,
  "required": ["settings", "sources"],
  "properties": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_root",
        "storage_limit_bytes",
        "user_agent",
        "max_concurrency",
        "max_per_host",
        "default_delay_seconds",
        "max_depth",
        "request_timeout_seconds",
        "max_retries",
        "retry_backoff_seconds"
      ],
      "properties": {
        "data_root": { "type": "string", "pattern": "^(data)(/[A-Za-z0-9._-]+)*$" },
        "storage_limit_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 10000000000,
          "default": 10000000000
        },
        "user_agent": { "type": "string", "minLength": 10, "maxLength": 300 },
        "contact": { "type": "string", "maxLength": 200 },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 16, "default": 8 },
        "max_per_host": { "type": "integer", "minimum": 1, "maximum": 4, "default": 2 },
        "default_delay_seconds": { "type": "number", "minimum": 0.5, "maximum": 60, "default": 1.0 },
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 3, "default": 3 },
        "request_timeout_seconds": { "type": "integer", "minimum": 5, "maximum": 120, "default": 30 },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 5, "default": 3 },
        "retry_backoff_seconds": { "type": "number", "minimum": 0.5, "maximum": 60, "default": 2.0 },
        "allowed_media_types": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["text/html", "application/pdf", "application/xml", "application/json", "text/plain", "text/vtt"]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "platform", "authority", "seeds", "policy"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]{2,40}$" },
          "domain": { "type": "string", "minLength": 4, "maxLength": 253 },
          "platform": {
            "enum": ["website", "youtube", "facebook", "instagram", "x", "job_board", "open_data", "news", "blog"]
          },
          "authority": { "enum": ["first_party", "third_party", "open_data"] },
          "enabled": { "type": "boolean", "default": true },
          "priority": { "type": "integer", "minimum": 0, "maximum": 3, "default": 2 },
          "seeds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "format": "uri", "pattern": "^https?://" }
          },
          "sitemaps": {
            "type": "array",
            "items": { "type": "string", "format": "uri", "pattern": "^https?://" }
          },
          "max_depth": { "type": "integer", "minimum": 0, "maximum": 3 },
          "follow_links": { "type": "boolean", "default": true },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["robots", "requires_auth"],
            "properties": {
              "robots": { "enum": ["respect", "ignore_if_absent"] },
              "tos_url": { "type": ["string", "null"], "format": "uri" },
              "requires_auth": { "type": "boolean" },
              "allowed_paths": { "type": "array", "items": { "type": "string" } },
              "excluded_paths": { "type": "array", "items": { "type": "string" } }
            }
          },
          "rate_limit": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "delay_seconds": { "type": "number", "minimum": 0.5, "maximum": 60 },
              "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 4 }
            }
          },
          "category_hints": {
            "type": "array",
            "items": { "enum": ["identity", "offer", "digital_presence", "hard_data"] }
          }
        }
      }
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "domains": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
