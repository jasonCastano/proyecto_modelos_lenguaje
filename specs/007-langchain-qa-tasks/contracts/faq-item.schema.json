{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonCastano/proyecto_modelos_lenguaje/specs/007-langchain-qa-tasks/contracts/faq-item.schema.json",
  "title": "FAQ item",
  "description": "One generated FAQ entry with citations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seed_id",
    "question",
    "answer",
    "citations",
    "topic_id",
    "coverage_item_id",
    "status",
    "prompt_version",
    "model"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "seed_id": {
      "type": ["string", "null"],
      "pattern": "^faq_[a-f0-9]{16}$"
    },
    "question": {
      "type": "string",
      "minLength": 3
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "topic_id": {
      "type": "string",
      "minLength": 1
    },
    "coverage_item_id": {
      "type": ["string", "null"],
      "pattern": "^[IODH]-[0-9]{2}$"
    },
    "status": {
      "type": "string",
      "enum": ["ready", "review", "missing_evidence"]
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "ready"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "citations": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "missing_evidence"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "citations": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "unit_id",
        "title",
        "url",
        "section_path",
        "page_start",
        "page_end",
        "time_start",
        "time_end",
        "authority",
        "citation"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^U[0-9]+$"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^unit_[a-f0-9]{16}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "section_path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "page_start": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "page_end": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "time_start": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "time_end": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "authority": {
          "type": "string",
          "enum": ["first_party", "open_data", "third_party"]
        },
        "citation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
