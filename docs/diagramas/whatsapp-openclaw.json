  "cards": [
    {
      "dot": "emerald",
      "title": "Un solo agente",
      "items": [
        "WhatsApp y la web usan el mismo ChatService: router, perfiles, memoria, blindaje, aprobación humana y citas",
        "El plugin lleva cada mensaje admitido al backend por loopback con X-Channel-Token",
        "Los usuarios del canal se guardan con un seudónimo; el número nunca llega al modelo"
      ]
    },
    {
      "dot": "orange",
      "title": "Seguridad del gateway",
      "items": [
        "Gateway solo en loopback y con token; WhatsApp usa una conexión saliente",
        "Allowlist E.164 o emparejamiento por código; sin grupos",
        "Agente nativo en sandbox Docker sin red, con tools.deny y el workspace en solo lectura"
      ]
    },
    {
      "dot": "slate",
      "title": "Modo degradado",
      "items": [
        "Si el backend no responde en 45 s, contesta el agente nativo de OpenClaw y avisa «modo básico»",
        "Usa el MCP valeria-tools con 18 herramientas de lectura; no escribe ni planifica"
      ]
    }
