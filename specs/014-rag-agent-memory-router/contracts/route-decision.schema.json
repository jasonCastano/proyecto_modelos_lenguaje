{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route-decision.schema.json",
  "title": "RouteDecision",
  "description": "Salida tipada de la puerta de decisión (FR-011, FR-015).",
  "type": "object",
  "additionalProperties": false,
  "required": ["route", "confidence", "reason", "decided_by"],
  "properties": {
    "route": {"enum": ["direct", "documental", "structured", "mixed", "out_of_scope", "clarify"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "maxLength": 200},
    "decided_by": {"enum": ["rules", "llm", "demo"]},
    "alternative": {
      "enum": ["direct", "documental", "structured", "mixed", "out_of_scope", "clarify", null]
    },
    "fallback_route": {"enum": ["documental", null]}
  }
}
