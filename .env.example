# Proveedor DeepSeek por API (spec 011).
# Copia este archivo a .env y completa la clave. `.env` NO se versiona.
DEEPSEEK_API_KEY=

# Opcionales: sobrescriben config/llm.toml para pruebas manuales o proxies.
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Modo demostración: respuestas de prueba sin red ni costo.
# PML_DEMO=1

# Observabilidad con LangSmith (opcional). LangSmith observa, no orquesta: traza enrutador,
# herramientas, recuperación y modelo de cada turno. Sin estas variables queda el log local
# $MANUELITA_STATE_DIR/logs/turns.jsonl.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=manuelita-modulo2

# Gatekeeper System One Jev de TypeSafe (spec 022, opcional). Cada integrante usa su propia clave
# (https://console.typesafe.ai). Sin clave, el enrutador funciona como siempre (reglas + LLM).
TYPESAFE_API_KEY=
# MANUELITA_JEV_ENABLED=1          # activa el gatekeeper sin editar config/agent.toml

# Qdrant con servidor (opcional): usa el índice HNSW. Sin ella se usa el modo local embebido.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Voz del agente con Phonon (spec 016). Token de lectura de Hugging Face; antes acepta las
# condiciones de https://huggingface.co/gradium/phonon-40m-es. Solo se usa para descargar el modelo.
HF_TOKEN=
# MANUELITA_VOICE_ENABLED=0        # desactiva la voz
# MANUELITA_VOICE=Ximena           # cambia la voz sin editar config/voice.toml

# Valer-IA (spec 018): clave HMAC (≥ 32 caracteres) para reconocer clientes por la huella de su correo.
# Si falta se genera en MANUELITA_STATE_DIR/identity.key. Cambiarla hace que no se reconozcan registros previos.
MANUELITA_IDENTITY_KEY=

# Plataforma de agentes (specs 025 y 027): en la web los cinco perfiles, incluido el planificador
# industrial, son de libre elección y no necesitan nada aquí. Estas variables solo aplican a WhatsApp.
# Seudónimos wa-<16 hex> separados por comas. Nunca números.
VALERIA_PLANNERS=
# Spec 031: seudónimos wa-<16 hex> de los números de prueba del equipo (sin límites; únicos con atajos del
# operador en modo abierto). Se calculan con `pml channels pseudonym --sender <número>`. Nunca números.
VALERIA_OPERATORS=
# MANUELITA_PLANNER_OPEN=1         # WhatsApp, solo durante la jornada de sustentación: cualquier usuario admitido

# Video pitch con MAGI-2 por la API de Higgsfield (spec 028, opcional). Solo para generar las
# escenas con `uv run pml pitch generate`; la app no la usa. Formato id:secreto (consola de Higgsfield).
HIGGSFIELD_API_KEY=

# Pestaña WhatsApp de la web (spec 032): número de la SIM de Valer-IA en formato E.164, `+57` y los
# 10 dígitos del celular, sin espacios ni guiones. Nunca en otro archivo; sin él la pestaña muestra «no disponible».
VALERIA_WHATSAPP_NUMBER=
