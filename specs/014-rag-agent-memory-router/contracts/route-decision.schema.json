{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route-decision.schema.json",
  "title": "RouteDecision",
  "description": "Salida tipada de la puerta de decisión (FR-011, FR-015).",
  "type": "object",
  "additionalProperties": false,
  "required": ["route", "confidence", "reason", "decided_by"],
  "properties": {
    "route": {"enum": ["direct", "documental", "structured", "mixed", "out_of_scope", "clarify"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "maxLength": 200},
    "decided_by": {"enum": ["rules", "llm", "demo"]},
    "alternative": {
      "enum": ["direct", "documental", "structured", "mixed", "out_of_scope", "clarify", null]
    },
    "fallback_route": {"enum": ["documental", null]},
    "scope_reason": {
      "description": "Spec 018: motivo de conducta de Valer-IA (solo out_of_scope, o identity con direct).",
      "enum": ["off_topic", "abuse", "harmful", "third_party", "prompt_extraction", "advice", "identity", "crisis", "unattainable", null]
    },
    "topic": {
      "description": "Spec 019: tema ajeno saneado (como máximo 4 palabras y 40 caracteres), solo con off_topic o advice.",
      "type": ["string", "null"],
      "maxLength": 40,
      "pattern": "^[a-záéíóúñü]+( [a-záéíóúñü]+){0,3}$"
    },
    "sentiment": {
      "description": "Spec 019: emoción del visitante propuesta por el enrutador LLM.",
      "enum": ["neutral", "satisfied", "confused", "frustrated", "angry", "distressed", null]
    },
    "kind": {
      "description": "Spec 019: tipo de pedido no atendible, solo con unattainable.",
      "enum": ["pricing", "commitment", "human", null]
    }
  }
}
