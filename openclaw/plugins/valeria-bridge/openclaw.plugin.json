{
  "id": "valeria-bridge",
  "name": "Valer-IA bridge",
  "description": "Envía los mensajes de WhatsApp a Valer-IA Caña por loopback; si falla, sigue el agente nativo.",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "backendUrl": { "type": "string", "pattern": "^https?://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?/?$" },
      "timeoutMs": { "type": "integer", "minimum": 5000, "maximum": 120000 },
      "channels": { "type": "array", "items": { "type": "string", "enum": ["whatsapp", "telegram"] } },
      "stickersDir": { "type": "string", "maxLength": 500 },
      "stickerThinkingMs": { "type": "integer", "minimum": 0, "maximum": 60000 }
    }
  }
}
