{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonCastano/proyecto_modelos_lenguaje/contracts/gold/coverage.schema.json",
  "title": "GoldCoverage",
  "description": "Matriz de los 24 ítems de información.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "items"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-gold-\\d{2}$" },
    "items": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "name",
        "category",
        "status",
        "unit_ids",
        "authority_counts",
        "conflict_ids",
        "gap_reason",
        "recommendation"
      ],
      "properties": {
        "item_id": { "type": "string", "pattern": "^[IODH]-\\d{2}$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "enum": ["identity", "offer", "digital_presence", "hard_data"] },
        "status": { "enum": ["covered", "partial", "missing"] },
        "unit_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^unit_[a-f0-9]{16}$" },
          "uniqueItems": true
        },
        "authority_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "conflict_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^conf_[a-f0-9]{16}$" },
          "uniqueItems": true
        },
        "gap_reason": { "type": ["string", "null"] },
        "recommendation": { "type": ["string", "null"] }
      }
    }
  }
}
