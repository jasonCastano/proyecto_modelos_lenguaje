{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonCastano/proyecto_modelos_lenguaje/contracts/gold/fact.schema.json",
  "title": "GoldFact",
  "description": "Hecho numérico o fechado con evidencia.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fact_id",
    "subject_id",
    "subject_label",
    "attribute",
    "value",
    "value_normalized",
    "unit",
    "year",
    "unit_id",
    "evidence",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "fact_id": { "type": "string", "pattern": "^fact_[a-f0-9]{16}$" },
    "subject_id": { "type": "string", "pattern": "^ent_[a-f0-9]{16}$" },
    "subject_label": { "type": "string", "minLength": 1 },
    "attribute": { "type": "string", "minLength": 1 },
    "value": { "type": "string", "minLength": 1 },
    "value_normalized": { "type": "string", "minLength": 1 },
    "unit": { "type": ["string", "null"] },
    "year": { "type": ["integer", "null"], "minimum": 1800, "maximum": 2100 },
    "unit_id": { "type": "string", "pattern": "^unit_[a-f0-9]{16}$" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "status": { "enum": ["current", "historical", "disputed", "ambiguous"] }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "doc_id",
        "artifact_id",
        "content_hash",
        "url",
        "title",
        "section_path",
        "page_start",
        "page_end",
        "time_start",
        "time_end",
        "authority",
        "published_at",
        "retrieved_at",
        "score"
      ],
      "properties": {
        "chunk_id": { "type": "string", "pattern": "^doc_[a-f0-9]{16}-s\\d{3}-c\\d{4}$" },
        "doc_id": { "type": "string", "pattern": "^doc_[a-f0-9]{16}$" },
        "artifact_id": { "type": "integer", "minimum": 1 },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "section_path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "page_start": { "type": ["integer", "null"], "minimum": 1 },
        "page_end": { "type": ["integer", "null"], "minimum": 1 },
        "time_start": { "type": ["number", "null"], "minimum": 0 },
        "time_end": { "type": ["number", "null"], "minimum": 0 },
        "authority": { "enum": ["first_party", "third_party", "open_data"] },
        "published_at": { "type": ["string", "null"], "format": "date-time" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
