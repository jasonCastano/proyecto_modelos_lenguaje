{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonCastano/proyecto_modelos_lenguaje/contracts/silver/run-report.schema.json",
  "title": "SilverRunReport",
  "description": "Reporte de calidad de una ejecución de la capa plata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "finished_at",
    "status",
    "config_hash",
    "cleaning_version",
    "tool_version",
    "git_commit",
    "input_artifacts",
    "processed",
    "skipped",
    "failed",
    "documents",
    "canonical_documents",
    "alias_documents",
    "chunks",
    "duplicates_exact",
    "duplicates_near",
    "tokens_in",
    "tokens_out",
    "bytes_out",
    "duration_seconds",
    "by_source",
    "by_media_type",
    "by_status",
    "skip_reasons",
    "failure_reasons",
    "quality_flags",
    "section_coverage",
    "report_paths"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-silver-\\d{2}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "status": {
      "enum": ["planned", "running", "completed", "completed_with_failures", "failed"]
    },
    "config_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cleaning_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "tool_version": { "type": "string", "minLength": 1 },
    "git_commit": { "type": ["string", "null"] },
    "input_artifacts": { "type": "integer", "minimum": 0 },
    "processed": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "documents": { "type": "integer", "minimum": 0 },
    "canonical_documents": { "type": "integer", "minimum": 0 },
    "alias_documents": { "type": "integer", "minimum": 0 },
    "chunks": { "type": "integer", "minimum": 0 },
    "duplicates_exact": { "type": "integer", "minimum": 0 },
    "duplicates_near": { "type": "integer", "minimum": 0 },
    "tokens_in": { "type": "integer", "minimum": 0 },
    "tokens_out": { "type": "integer", "minimum": 0 },
    "bytes_out": { "type": "integer", "minimum": 0 },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "by_source": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "by_media_type": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "by_status": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "skip_reasons": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "failure_reasons": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "quality_flags": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "section_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["with_title", "without_title"],
      "properties": {
        "with_title": { "type": "integer", "minimum": 0 },
        "without_title": { "type": "integer", "minimum": 0 }
      }
    },
    "report_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
