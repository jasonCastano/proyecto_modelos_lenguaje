# Variables del gateway OpenClaw y del puente de Valer-IA (spec 024).
# Copiar a %USERPROFILE%\.openclaw-valeria\.env (y las de Valer-IA al .env del proyecto).
# NUNCA versionar los valores reales: tokens, claves ni números de teléfono.

# Modelo en la nube (el mismo que usa el backend)
DEEPSEEK_API_KEY=

# Gateway: token de acceso (>= 32 bytes aleatorios, p. ej. `openssl rand -hex 32`)
OPENCLAW_GATEWAY_TOKEN=

# Puente OpenClaw -> backend: secreto compartido y sal de los seudónimos de teléfono
VALERIA_CHANNEL_TOKEN=
VALERIA_CHANNEL_SALT=

# Números autorizados en E.164 (integrantes e invitados confirmados), p. ej. +57XXXXXXXXXX
WA_ALLOW_1=
WA_ALLOW_2=
WA_ALLOW_3=

# Rutas de ejecución (fuera del repositorio salvo VALERIA_REPO)
VALERIA_REPO=
OPENCLAW_WORKSPACE_DIR=
MANUELITA_STATE_DIR=
QDRANT_URL=http://127.0.0.1:6333

# Extra opcional
TELEGRAM_BOT_TOKEN=
