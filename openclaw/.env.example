# Variables del gateway OpenClaw y del puente de Valer-IA (spec 024).
# Copiar a %USERPROFILE%\.openclaw-valeria\.env (y las de Valer-IA al .env del proyecto).
# NUNCA versionar los valores reales: tokens, claves ni números de teléfono.

# Modelo en la nube (el mismo que usa el backend)
DEEPSEEK_API_KEY=

# Gateway: token de acceso (>= 32 bytes aleatorios, p. ej. `openssl rand -hex 32`)
OPENCLAW_GATEWAY_TOKEN=

# Puente OpenClaw -> backend: secreto compartido y sal de los seudónimos de teléfono
VALERIA_CHANNEL_TOKEN=
VALERIA_CHANNEL_SALT=

# Acceso a WhatsApp (spec 028). Se cambia con `.\scripts\openclaw_env.ps1 -Mode open|closed`:
#   closed (por defecto): WA_DM_POLICY=allowlist y responden solo WA_ALLOW_1..3 (números de prueba);
#   open (ensayo del viernes y sustentación): WA_DM_POLICY=open y WA_ALLOW_1=* (cualquier número).
# Los números de prueba son los de quienes le escriben a Valer-IA (formato +57XXXXXXXXXX), nunca el
# número de la SIM de Valer-IA. El script los guarda en WA_TEST_1..3 mientras el modo está abierto.
WA_DM_POLICY=allowlist
WA_ALLOW_1=
WA_ALLOW_2=
WA_ALLOW_3=
WA_TEST_1=
WA_TEST_2=
WA_TEST_3=

# Rutas de ejecución (fuera del repositorio salvo VALERIA_REPO)
VALERIA_REPO=
OPENCLAW_WORKSPACE_DIR=
MANUELITA_STATE_DIR=
QDRANT_URL=http://127.0.0.1:6333

# Solo durante la prueba técnica de voz (S1): registra los primeros 80 caracteres recibidos.
# VALERIA_BRIDGE_DEBUG=1
