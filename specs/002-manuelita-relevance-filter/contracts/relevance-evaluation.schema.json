{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelita-rag.local/contracts/relevance-evaluation.schema.json",
  "title": "RelevanceEvaluation",
  "description": "Current relevance decision for one bronze artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "run_id",
    "source_id",
    "url_canonical",
    "decision",
    "level",
    "score",
    "method",
    "explanation",
    "content_hash",
    "config_hash",
    "manual_override",
    "evaluated_at",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_id": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "source_id": { "type": "string", "pattern": "^[a-z0-9_]{2,40}$" },
    "url_canonical": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "title": { "type": ["string", "null"], "maxLength": 500 },
    "decision": { "enum": ["keep", "remove", "review"] },
    "level": { "enum": ["direct", "contextual", "none"] },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "method": { "enum": ["rule_based", "manual"] },
    "explanation": { "type": "string", "minLength": 3, "maxLength": 1000 },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "config_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manual_override": { "type": "boolean" },
    "reviewer": { "type": ["string", "null"], "maxLength": 120 },
    "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "location", "snippet", "weight"],
        "properties": {
          "term": { "type": "string", "minLength": 1, "maxLength": 200 },
          "location": { "enum": ["title", "body", "url", "metadata"] },
          "snippet": { "type": "string", "minLength": 1, "maxLength": 500 },
          "weight": { "type": "integer", "minimum": -100, "maximum": 100 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "enum": ["keep", "review"] } } },
      "then": { "properties": { "evidence": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "manual_override": { "const": true } } },
      "then": { "required": ["reviewer", "reviewed_at"] }
    }
  ]
}
