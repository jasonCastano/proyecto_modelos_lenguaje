{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelita-rag.local/contracts/artifact.schema.json",
  "title": "BronzeArtifact",
  "description": "One raw artifact record as exported in manifests and catalog JSON output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "campaign_id",
    "source_id",
    "authority",
    "url_original",
    "url_canonical",
    "content_hash",
    "media_type",
    "byte_size",
    "storage_path",
    "retrieved_at",
    "http_status",
    "language",
    "language_method",
    "version"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_id": { "type": "integer", "minimum": 1 },
    "campaign_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "source_id": { "type": "string", "pattern": "^[a-z0-9_]{2,40}$" },
    "authority": { "enum": ["first_party", "third_party", "open_data"] },
    "url_original": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "url_canonical": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "text_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "media_type": { "type": "string", "minLength": 3, "maxLength": 200 },
    "byte_size": { "type": "integer", "minimum": 1 },
    "storage_path": {
      "type": "string",
      "pattern": "^raw/[a-z0-9_]+/[a-z0-9-]+/[a-f0-9]{64}\\.[a-z0-9]{2,5}$"
    },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
    "language": { "enum": ["es", "en", "und"] },
    "language_method": { "enum": ["html_lang", "heuristic", "unknown"] },
    "title": { "type": ["string", "null"], "maxLength": 500 },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 },
    "coverage_item_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[IODH]-[0-9]{2}$" }
    },
    "retracted_at": { "type": ["string", "null"], "format": "date-time" },
    "retraction_reason": { "type": ["string", "null"], "maxLength": 500 }
  }
}
