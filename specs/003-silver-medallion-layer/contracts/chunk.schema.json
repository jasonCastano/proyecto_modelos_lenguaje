{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonCastano/proyecto_modelos_lenguaje/contracts/silver/chunk.schema.json",
  "title": "SilverChunk",
  "description": "Registro de fragmento recuperable y citable de la capa plata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chunk_id",
    "doc_id",
    "artifact_id",
    "content_hash",
    "source_id",
    "authority",
    "url",
    "title",
    "section_id",
    "section_title",
    "section_path",
    "section_level",
    "chunk_order",
    "text",
    "char_start",
    "char_end",
    "token_count",
    "page_start",
    "page_end",
    "time_start",
    "time_end",
    "language",
    "media_type",
    "quality_flags",
    "duplicate_of",
    "retrieved_at",
    "license_note"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "chunk_id": {
      "type": "string",
      "pattern": "^doc_[a-f0-9]{16}-s\\d{3}-c\\d{4}$"
    },
    "doc_id": { "type": "string", "pattern": "^doc_[a-f0-9]{16}$" },
    "artifact_id": { "type": "integer", "minimum": 1 },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_id": { "type": "string", "minLength": 1 },
    "authority": { "enum": ["first_party", "third_party", "open_data"] },
    "url": { "type": "string", "format": "uri" },
    "title": { "type": "string", "minLength": 1 },
    "section_id": {
      "type": "string",
      "pattern": "^doc_[a-f0-9]{16}-s\\d{3}$"
    },
    "section_title": { "type": "string", "minLength": 1 },
    "section_path": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "section_level": { "type": "integer", "minimum": 0, "maximum": 6 },
    "chunk_order": { "type": "integer", "minimum": 0 },
    "text": { "type": "string", "minLength": 1 },
    "char_start": { "type": "integer", "minimum": 0 },
    "char_end": { "type": "integer", "minimum": 1 },
    "token_count": { "type": "integer", "minimum": 1 },
    "page_start": { "type": ["integer", "null"], "minimum": 1 },
    "page_end": { "type": ["integer", "null"], "minimum": 1 },
    "time_start": { "type": ["number", "null"], "minimum": 0 },
    "time_end": { "type": ["number", "null"], "minimum": 0 },
    "language": { "enum": ["es", "en", "und"] },
    "media_type": { "type": "string", "minLength": 1 },
    "quality_flags": {
      "type": "array",
      "items": {
        "enum": [
          "no_text",
          "scanned_pdf",
          "encrypted_pdf",
          "low_text_density",
          "table_heavy",
          "multi_column_suspect",
          "encoding_repaired",
          "no_section",
          "short_section",
          "exact_duplicate",
          "near_duplicate",
          "language_unknown",
          "subtitle_kind_unknown"
        ]
      },
      "uniqueItems": true
    },
    "duplicate_of": {
      "type": ["string", "null"],
      "pattern": "^doc_[a-f0-9]{16}-s\\d{3}-c\\d{4}$"
    },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "license_note": { "type": "string", "minLength": 1 }
  }
}
