# Build artifacts
build/
dist/
*.egg-info/
*.egg

# Web frontend
web/node_modules/
web/dist/
web/coverage/
web/test-results/
web/playwright-report/

# Medallion data: bronze, silver and gold are versioned in Git LFS.
# Quarantine, caches, smoke runs and transient SQLite files stay out of Git.
data/quarantine/
data/*/_meta/cache/
data/*/_meta/smoke/
data/module1/
# Índice vectorial del Módulo 2: artefacto derivado, reproducible con `rag index build`.
# Incluye data/module2/structured/ (tabla SQLite derivada del oro, `agent build-structured`).
data/module2/
data.zip
*.sqlite3-wal
*.sqlite3-shm

# Local agent memory (Engram)
.engram/

# Local agent skills and tooling
.agents/
skills-lock.json
.tgrep/
.archify/

# Visual audit artifacts
artifacts/metrics-layout/

# OS / editors
.DS_Store
Thumbs.db
*.tmp
*.swp
.vscode/
.idea/

# Logs
*.log
web/*.tsbuildinfo

# Spec 024: OpenClaw (secretos, sesión de WhatsApp y dependencias del plugin fuera de Git)
openclaw/**/.env
openclaw/plugins/*/node_modules/
openclaw/plugins/*/dist/
**/.openclaw*/

# Video pitch (spec 028): clip de calibración de Higgsfield, no va al montaje.
video/pitch/calibracion/

# Video pitch v2 (spec 029): borrador del montaje antes de `pml pitch publish`.
video/pitch/borrador/
