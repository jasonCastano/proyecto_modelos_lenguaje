{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/layout-audit.schema.json",
  "title": "Metrics layout audit report",
  "description": "Resultado de la auditoría visual de la pestaña Métricas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "app_url",
    "browser",
    "viewports",
    "data_states",
    "findings",
    "passed"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "app_url": {
      "type": "string",
      "format": "uri"
    },
    "browser": {
      "type": "string",
      "minLength": 1
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/viewportResult"
      }
    },
    "data_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dataStateResult"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layoutFinding"
      }
    },
    "passed": {
      "type": "boolean"
    }
  },
  "$defs": {
    "viewportResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "width",
        "height",
        "zoom",
        "columns",
        "horizontal_scroll",
        "screenshots",
        "passed"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "horizontal_scroll": {
          "type": "boolean"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "dataStateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "warning_visible",
        "warning_separate",
        "passed"
      ],
      "properties": {
        "state": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "warning_visible": {
          "type": "boolean"
        },
        "warning_separate": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "layoutFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewport",
        "kind",
        "element_a",
        "detail",
        "severity"
      ],
      "properties": {
        "viewport": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "overlap",
            "horizontal_scroll",
            "clipping",
            "missing_element",
            "wrong_columns"
          ]
        },
        "element_a": {
          "type": "string",
          "minLength": 1
        },
        "element_b": {
          "type": [
            "string",
            "null"
          ]
        },
        "area": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        }
      }
    }
  }
}
