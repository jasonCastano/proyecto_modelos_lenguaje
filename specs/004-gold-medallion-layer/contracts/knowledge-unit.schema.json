{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonCastano/proyecto_modelos_lenguaje/contracts/gold/knowledge-unit.schema.json",
  "title": "KnowledgeUnit",
  "description": "Unidad extractiva y citable de la capa oro.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unit_id",
    "topic_id",
    "topic_title",
    "text",
    "unit_type",
    "language",
    "authority",
    "confidence",
    "status",
    "entity_ids",
    "coverage_item_ids",
    "evidence",
    "fact_id",
    "text_hash",
    "quality_flags",
    "url",
    "title",
    "section_path",
    "page_start",
    "page_end",
    "time_start",
    "time_end",
    "published_at",
    "retrieved_at",
    "license_note"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "unit_id": { "type": "string", "pattern": "^unit_[a-f0-9]{16}$" },
    "topic_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "topic_title": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "unit_type": { "enum": ["passage", "fact"] },
    "language": { "enum": ["es", "en", "und"] },
    "authority": { "enum": ["first_party", "third_party", "open_data"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "enum": ["current", "historical", "disputed", "ambiguous"] },
    "entity_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ent_[a-f0-9]{16}$" },
      "uniqueItems": true
    },
    "coverage_item_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[IODH]-\\d{2}$" },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "fact_id": { "type": ["string", "null"], "pattern": "^fact_[a-f0-9]{16}$" },
    "text_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "quality_flags": {
      "type": "array",
      "items": {
        "enum": [
          "topic_uncertain",
          "ambiguous_value",
          "conflicting",
          "short_unit",
          "duplicate_unit",
          "english_content",
          "low_authority"
        ]
      },
      "uniqueItems": true
    },
    "url": { "type": "string", "format": "uri" },
    "title": { "type": "string", "minLength": 1 },
    "section_path": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "page_start": { "type": ["integer", "null"], "minimum": 1 },
    "page_end": { "type": ["integer", "null"], "minimum": 1 },
    "time_start": { "type": ["number", "null"], "minimum": 0 },
    "time_end": { "type": ["number", "null"], "minimum": 0 },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "license_note": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "doc_id",
        "artifact_id",
        "content_hash",
        "url",
        "title",
        "section_path",
        "page_start",
        "page_end",
        "time_start",
        "time_end",
        "authority",
        "published_at",
        "retrieved_at",
        "score"
      ],
      "properties": {
        "chunk_id": { "type": "string", "pattern": "^doc_[a-f0-9]{16}-s\\d{3}-c\\d{4}$" },
        "doc_id": { "type": "string", "pattern": "^doc_[a-f0-9]{16}$" },
        "artifact_id": { "type": "integer", "minimum": 1 },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "section_path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "page_start": { "type": ["integer", "null"], "minimum": 1 },
        "page_end": { "type": ["integer", "null"], "minimum": 1 },
        "time_start": { "type": ["number", "null"], "minimum": 0 },
        "time_end": { "type": ["number", "null"], "minimum": 0 },
        "authority": { "enum": ["first_party", "third_party", "open_data"] },
        "published_at": { "type": ["string", "null"], "format": "date-time" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
